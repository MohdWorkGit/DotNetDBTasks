# ===========================================
# DotNetDBTasks Environment Configuration
# ===========================================
# Copy this file to .env and update the values

# ---------- Public domain ----------
# The domain your Cloudflare tunnel points to (e.g. https://tasks.example.com)
APP_DOMAIN=https://tasks.example.com

# ---------- Database (Oracle) ----------
DB_PASSWORD=YourStrong@Passw0rd

# ---------- JWT Authentication ----------
# IMPORTANT: Change this to a cryptographically random string (minimum 32 characters)
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_SECRET_KEY_AT_LEAST_32_CHARS_LONG_12345
JWT_ISSUER=DotNetDBTasks
JWT_AUDIENCE=DotNetDBTasks

# ---------- LDAP ----------
LDAP_ADMIN_PASSWORD=LdapAdmin@123

# ---------- Port mappings ----------
# The client port is what Cloudflare tunnel should point to
CLIENT_PORT=80
