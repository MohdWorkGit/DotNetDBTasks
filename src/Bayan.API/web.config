<?xml version="1.0" encoding="utf-8"?>
<!--
  Base web.config used as the template for `dotnet publish`. The SDK injects the
  <handlers> and <aspNetCore> elements automatically; the <security> block below is
  preserved so the published site ships with Windows Authentication ready for SSO.

  IMPORTANT: the windowsAuthentication/anonymousAuthentication sections are locked at
  the IIS server level by default, so IIS returns HTTP 500.19 until they are unlocked
  once per server (run as admin):

    %windir%\system32\inetsrv\appcmd unlock config /section:windowsAuthentication
    %windir%\system32\inetsrv\appcmd unlock config /section:anonymousAuthentication

  Alternatively, delete the <security> block here and enable the two auth methods in
  IIS Manager (site -> Authentication) instead, which needs no unlocking.
-->
<configuration>
  <system.webServer>
    <security>
      <authentication>
        <!-- Anonymous keeps the SPA and JWT-protected endpoints reachable; -->
        <!-- Windows lets /api/auth/sso challenge for the domain identity on demand. -->
        <anonymousAuthentication enabled="true" />
        <windowsAuthentication enabled="true" />
      </authentication>
    </security>

    <!--
      The SDK fills in processPath, arguments and hostingModel at publish time; the
      attributes below are ours and survive that transform.

      shutdownTimeLimit is the middle rung of the shutdown ladder and the reason it is
      set at all: the default is 10 seconds, which is far too short for this app. A
      scheduled export that is cancelled cleanly writes its final run status and flushes
      its incremental checkpoints (ScheduledTaskRunner.RunAsync's finally block), but
      only if the host is given time to unwind. The three limits must stay ordered:

        HostOptions.ShutdownTimeout (90s)  <  this (100s)  <  app pool shutdownTimeLimit (120s)

      Raise all three together or none of them — an inner value larger than an outer one
      just means the outer one kills the process first.
    -->
    <aspNetCore shutdownTimeLimit="100" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout">
      <environmentVariables>
        <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
      </environmentVariables>
    </aspNetCore>

    <!--
      Gives the app pool's preloadEnabled/AlwaysRunning setting a concrete page to warm,
      so the three background workers (query jobs, result-cache maintenance, scheduled
      exports) start with Windows instead of waiting for the first visitor. Requires the
      IIS Application Initialization feature; without it this element is ignored.
    -->
    <applicationInitialization doAppInitAfterRestart="true">
      <add initializationPage="/" />
    </applicationInitialization>
  </system.webServer>
</configuration>
